CompileFlags:
  Add:
    # Language standard
    - -std=c++20

    # Platform defines — mirror the Windows x64 MSVC target
    - -D_WIN32
    - -D_WIN64
    - -DWIN32_LEAN_AND_MEAN
    - -DNOMINMAX
    - -DNDEBUG
    - -D_CONSOLE

    # BakkasMod SDK headers
    # Path is machine-specific (resolved via Windows registry in MSBuild via BakkesMod.props).
    # For IDE support, add your local path here or set clangd.arguments in .vscode/settings.json:
    #   -I<path-to-bakkesmodsdk>/include
    # Example (WSL2): -I/mnt/c/Users/<you>/AppData/Roaming/bakkesmod/bakkesmod/bakkesmodsdk/include

    # vcpkg x64-windows includes
    # Path is machine-specific. For IDE support, add your local path here:
    #   -I<vcpkg-root>/installed/x64-windows/include
    # Example (WSL2): -I/mnt/c/Users/<you>/vcpkg/installed/x64-windows/include

    # ImGui (vendored in IMGUI/)
    - -IIMGUI

    # Suppress MSVC-specific warnings that clang doesn't understand
    - -Wno-unknown-pragmas
    - -Wno-ignored-attributes
    - -Wno-microsoft-include

  # Use clang-cl to better mimic MSVC ABI for SDK headers
  Compiler: clang++

Diagnostics:
  # Suppress noise from BakkesMod SDK and third-party headers
  Suppress:
    - pp_including_mainfile_in_preamble
  UnusedIncludes: None

Index:
  Background: Build

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
