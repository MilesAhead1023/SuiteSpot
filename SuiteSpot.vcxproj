xcopy "%25PROJECT_DIR%25assets\icons" "%25BM%25\data\SuiteSpot\Resources\Icons" /E /I /Y
echo [PostBuild] Copying logos...
xcopy "%25PROJECT_DIR%25assets\logos" "%25BM%25\data\SuiteSpot\Resources\logos" /E /I /Y
echo [PostBuild] Copying images...
xcopy "%25PROJECT_DIR%25assets\images" "%25BM%25\data\SuiteSpot\Resources" /I /Y
echo [PostBuild] Copying NoPreview.jpg...
copy /Y "%25PROJECT_DIR%25assets\images\NoPreview.jpg" "%25BM%25\data\SuiteSpot\Workshop\NoPreview.jpg"
echo [PostBuild] Copying training_packs.json...
copy /Y "%25PROJECT_DIR%25assets\data\training_packs.json" "%25BM%25\data\SuiteSpot\TrainingSuite\training_packs.json"
echo [PostBuild] Copying fonts...
xcopy "%25PROJECT_DIR%25assets\fonts" "%25BM%25\data\fonts" /I /Y
if not exist "%25DLL%25" (
  echo [PostBuild] ERROR: Built DLL not found: "%25DLL%25"
  exit /b 1
)
if not exist "%25PATCH%25" (
  echo [PostBuild] WARN: Patcher not found: "%25PATCH%25"
